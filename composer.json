{
    "name": "opencodeco/hyperf-frankenphp",
    "description": "🧟 Everything you need to get Hyperf working with FrankenPHP app server.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "leocavalcante",
            "email": "lc@leocavalcante.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Hyperf\\FrankenPhp\\": "src/"
        }
    },
    "require": {
        "laminas/laminas-httphandlerrunner": "^2.10",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1"
    },
    "require-dev": {
        "hyperf/context": "^3.1",
        "hyperf/dispatcher": "^3.1",
        "hyperf/http-server": "^3.1"
    },
    "extra": {
        "hyperf": {
            "config": "Hyperf\\FrankenPhp\\ConfigProvider"
        }
    }
}
